\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces À esquerda, distribuição agregada do $\alpha $ da melhor iteração nas $1\,500$ execuções, com a referência uniforme tracejada; a uniformidade é rejeitada por Kolmogorov--Smirnov ($p \approx 10^{-30}$). À direita, média por instância com intervalo de confiança de $95\%$: o melhor $\alpha $ varia de $0{,}15$ a $0{,}87$ conforme a instância.}}{26}{figure.4}\protected@file@percent }
\newlabel{fig:grasp-alpha}{{4}{26}{À esquerda, distribuição agregada do $\alpha $ da melhor iteração nas $1\,500$ execuções, com a referência uniforme tracejada; a uniformidade é rejeitada por Kolmogorov--Smirnov ($p \approx 10^{-30}$). À direita, média por instância com intervalo de confiança de $95\%$: o melhor $\alpha $ varia de $0{,}15$ a $0{,}87$ conforme a instância}{figure.4}{}}
\@writefile{lot}{\contentsline {table}{\numberline {6}{Análise do $\alpha $ por instância: média e mediana do $\alpha $ da melhor iteração, e correlação de Spearman média (entre iterações de uma execução, média sobre as $100$ execuções, com IC de $95\%$) entre o $\alpha $ e o valor após a busca local. Todas as correlações diferem de zero (Wilcoxon, $p<10^{-15}$).}}{26}{table.6}\protected@file@percent }
\newlabel{tab:grasp-alpha}{{6}{26}{Análise do $\alpha $ por instância: média e mediana do $\alpha $ da melhor iteração, e correlação de Spearman média (entre iterações de uma execução, média sobre as $100$ execuções, com IC de $95\%$) entre o $\alpha $ e o valor após a busca local. Todas as correlações diferem de zero (Wilcoxon, $p<10^{-15}$)}{table.6}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Valor após a busca local em função do $\alpha $ da iteração (pontos: iterações de $25$ sementes; linha: média por faixa de $\alpha $), nas duas instâncias de comportamento extremo. Em Itajubá a qualidade cresce com $\alpha $; em Milão há um pico perto de $\alpha = 0{,}15$ seguido de queda.}}{27}{figure.5}\protected@file@percent }
\newlabel{fig:grasp-alpha-scatter}{{5}{27}{Valor após a busca local em função do $\alpha $ da iteração (pontos: iterações de $25$ sementes; linha: média por faixa de $\alpha $), nas duas instâncias de comportamento extremo. Em Itajubá a qualidade cresce com $\alpha $; em Milão há um pico perto de $\alpha = 0{,}15$ seguido de queda}{figure.5}{}}
